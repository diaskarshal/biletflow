# Copy to .env.vercel.local; never commit the filled file.
# Use a separate database and Blob store for Preview deployments.
VERCEL=1
VERCEL_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
FRONTEND_URL=https://YOUR-PROJECT.vercel.app
UPLOADS_BACKEND=vercel_blob
# A public Blob store for event covers only. Do not use it for private documents.
BLOB_READ_WRITE_TOKEN=
# Used only by the manual seed command. Use a generated password for the hosted demo.
DEMO_PASSWORD=
# Real email remains pending until a sender is configured.
SMTP_HOST=localhost
SMTP_ENABLED=false
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@biletflow.kz
